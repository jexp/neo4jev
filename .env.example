# Neo4j connection — defaults target the public Neo4j "Companies KG" demo
# (read-only, public credentials; safe to share).
NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687
NEO4J_USERNAME=companies2
NEO4J_PASSWORD=companies2
NEO4J_DATABASE=companies2

# TypeSafe API — required. Get a key from TypeSafe; no public default exists.
TYPESAFE_API_KEY=
# Optional: override the default model used for system_one calls.
# TYPESAFE_DEFAULT_MODEL=
